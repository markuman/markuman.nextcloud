# {{ ansible_managed }}
#
# entry point for modsecurity_rules_file in the nextcloud vhost. load order:
#   1. engine (own config, not the debian default /etc/nginx/modsecurity.conf)
#   2. crs setup (SecDefaultAction, package defaults)
#   3. nextcloud tuning of the role (paranoia level, crs nextcloud exclusions)
#   4. own rules before the crs (SecAction setvar, ctl exclusions)
#   5. crs rules
#   6. own rules after the crs (SecRuleUpdateTarget*, SecRuleRemove*)

Include {{ nextcloud_modsecurity_dir }}/engine.conf

Include {{ nextcloud_modsecurity_crs_setup }}
Include {{ nextcloud_modsecurity_dir }}/nextcloud.conf
Include /etc/modsecurity/crs/REQUEST-900-EXCLUSION-RULES-BEFORE-CRS.conf
Include {{ nextcloud_modsecurity_dir }}/rules-before-crs/*.conf

Include {{ nextcloud_modsecurity_crs_rules }}

Include {{ nextcloud_modsecurity_dir }}/rules-after-crs/*.conf
Include /etc/modsecurity/crs/RESPONSE-999-EXCLUSION-RULES-AFTER-CRS.conf
