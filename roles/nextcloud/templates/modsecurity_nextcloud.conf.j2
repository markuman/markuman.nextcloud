# {{ ansible_managed }}

# debian defaults (DetectionOnly, body limits, audit log, ...)
Include /etc/nginx/modsecurity.conf

SecRuleEngine {{ nextcloud_modsecurity_engine }}
# no data leakage detection, but no buffering of (large) downloads either
SecResponseBodyAccess Off
# uploads are larger than SecRequestBodyLimit: inspect the first part, pass the rest
SecRequestBodyLimitAction ProcessPartial

# OWASP core rule set
Include /etc/modsecurity/crs/crs-setup.conf

SecAction \
  "id:900000,\
  phase:1,\
  nolog,\
  pass,\
  t:none,\
  setvar:tx.paranoia_level={{ nextcloud_modsecurity_paranoia_level }}"

SecAction \
  "id:900130,\
  phase:1,\
  nolog,\
  pass,\
  t:none,\
  setvar:tx.crs_exclusions_nextcloud=1"

Include /etc/nginx/modsecurity_nextcloud_exclusions.conf
Include /etc/modsecurity/crs/REQUEST-900-EXCLUSION-RULES-BEFORE-CRS.conf
Include /usr/share/modsecurity-crs/rules/*.conf
Include /etc/modsecurity/crs/RESPONSE-999-EXCLUSION-RULES-AFTER-CRS.conf
