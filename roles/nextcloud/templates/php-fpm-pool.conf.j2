; {{ ansible_managed }}

[nextcloud]
user = www-data
group = www-data

listen = {{ nextcloud_php_fpm_socket }}
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = dynamic
pm.max_children = {{ nextcloud_php_fpm.max_children }}
pm.start_servers = {{ nextcloud_php_fpm.start_servers }}
pm.min_spare_servers = {{ nextcloud_php_fpm.min_spare_servers }}
pm.max_spare_servers = {{ nextcloud_php_fpm.max_spare_servers }}
pm.max_requests = 500

env[HOSTNAME] = $HOSTNAME
env[PATH] = /usr/local/bin:/usr/bin:/bin
env[TMP] = /tmp
env[TMPDIR] = /tmp
env[TEMP] = /tmp
